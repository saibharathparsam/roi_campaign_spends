{
  "datasets": [
    {
      "name": "autoloader_metadata",
      "displayName": "Auto Loader File Metadata",
      "queryLines": [
        "SELECT\n",
        "  'sales' AS source,\n",
        "  path,\n",
        "  size,\n",
        "  create_time,\n",
        "  discovery_time,\n",
        "  processed_time,\n",
        "  commit_time,\n",
        "  ingestion_state\n",
        "FROM\n",
        "  cloud_files_state('/Volumes/retail_demo/bronze/raw_data/_autoloader/sales/checkpoint')\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'promotions' AS source,\n",
        "  path,\n",
        "  size,\n",
        "  create_time,\n",
        "  discovery_time,\n",
        "  processed_time,\n",
        "  commit_time,\n",
        "  ingestion_state\n",
        "FROM\n",
        "  cloud_files_state('/Volumes/retail_demo/bronze/raw_data/_autoloader/promotions/checkpoint')\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'product' AS source,\n",
        "  path,\n",
        "  size,\n",
        "  create_time,\n",
        "  discovery_time,\n",
        "  processed_time,\n",
        "  commit_time,\n",
        "  ingestion_state\n",
        "FROM\n",
        "  cloud_files_state('/Volumes/retail_demo/bronze/raw_data/_autoloader/product/checkpoint')"
      ]
    },
    {
      "name": "latest_per_source",
      "displayName": "Latest Processing Per Source",
      "queryLines": [
        "SELECT\n",
        "  source,\n",
        "  MAX(processed_time) AS latest_processed_time,\n",
        "  MAX(commit_time) AS latest_commit_time,\n",
        "  COUNT(path) AS total_files,\n",
        "  SUM(size) AS total_size_bytes\n",
        "FROM\n",
        "  (\n",
        "    SELECT\n",
        "      'sales' AS source,\n",
        "      path,\n",
        "      size,\n",
        "      processed_time,\n",
        "      commit_time,\n",
        "      ingestion_state\n",
        "    FROM\n",
        "      cloud_files_state('/Volumes/retail_demo/bronze/raw_data/_autoloader/sales/checkpoint')\n",
        "    UNION ALL\n",
        "    SELECT\n",
        "      'promotions' AS source,\n",
        "      path,\n",
        "      size,\n",
        "      processed_time,\n",
        "      commit_time,\n",
        "      ingestion_state\n",
        "    FROM\n",
        "      cloud_files_state('/Volumes/retail_demo/bronze/raw_data/_autoloader/promotions/checkpoint')\n",
        "    UNION ALL\n",
        "    SELECT\n",
        "      'product' AS source,\n",
        "      path,\n",
        "      size,\n",
        "      processed_time,\n",
        "      commit_time,\n",
        "      ingestion_state\n",
        "    FROM\n",
        "      cloud_files_state('/Volumes/retail_demo/bronze/raw_data/_autoloader/product/checkpoint')\n",
        "  )\n",
        "GROUP BY\n",
        "  source"
      ]
    }
  ],
