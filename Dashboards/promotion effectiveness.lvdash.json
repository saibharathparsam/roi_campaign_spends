{
  "datasets": [
    {
      "name": "promotion_impact",
      "displayName": "Promotion Impact",
      "config": {
        "version": "1.1",
        "source": "retail_demo.gold.promotion_impact",
        "dimensions": [
          {
            "name": "promotion_name",
            "expr": "promotion_name",
            "displayName": "Promotion Name"
          },
          {
            "name": "promotion_effectiveness",
            "expr": "promotion_effectiveness",
            "displayName": "Promotion Effectiveness"
          }
        ],
        "measures": [
          {
            "name": "total_promotion_investment",
            "expr": "SUM(promotion_investment)",
            "displayName": "Total Promotion Investment",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "avg_revenue_uplift_pct",
            "expr": "AVG(revenue_uplift_pct)",
            "displayName": "Avg Revenue Uplift %",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "avg_unit_uplift_pct",
            "expr": "AVG(unit_uplift_pct)",
            "displayName": "Avg Unit Uplift %",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          }
        ]
      }
    },
    {
      "name": "promotion_sales",
      "displayName": "Promotion Sales",
      "config": {
        "version": "1.1",
        "source": "retail_demo.silver.promotion_sales",
        "dimensions": [
          {
            "name": "sale_month",
            "expr": "DATE_TRUNC('MONTH', sale_date)",
            "displayName": "Sale Month",
            "format": {
              "type": "date",
              "dateFormat": "locale_short_month"
            }
          },
          {
            "name": "product_name",
            "expr": "product_name",
            "displayName": "Product Name"
          }
        ],
        "measures": [
          {
            "name": "total_sales",
            "expr": "SUM(revenue)",
            "displayName": "Total Sales",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "total_units_sold",
            "expr": "SUM(units_sold)",
            "displayName": "Total Units Sold",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            }
          }
        ]
      }
    }
  ],
  "pages": [
